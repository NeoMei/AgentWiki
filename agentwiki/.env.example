# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agentwiki

# JWT
JWT_SECRET=change-me-in-production

# Server
PORT=3000

# Local sync plugin enrollment
PUBLIC_API_URL=https://your-domain.example/api
LOCAL_SYNC_PACKAGE_VERSION=0.2.2

# Server-side editing assistant
# OpenCode is installed with the server package. Override only when using a
# separately managed binary.
# OPENCODE_BIN=/absolute/path/to/opencode
ASSIST_OPENCODE_TIMEOUT_MS=180000
