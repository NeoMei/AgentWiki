# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agentwiki

# JWT
JWT_SECRET=change-me-in-production

# Server
PORT=3000

# Durable attachment storage. Production must provision this narrow absolute
# path outside the release tree with owner-only mode 0700; do not use /tmp or $HOME.
ATTACHMENT_STORAGE_PATH=/var/lib/agentwiki/attachments
# Per-file upload ceiling: 10 MiB. Nginx allows 11 MiB for multipart overhead.
ATTACHMENT_MAX_FILE_BYTES=10485760
# Total active attachment bytes allowed per Space: 500 MiB.
ATTACHMENT_MAX_SPACE_BYTES=524288000
# Reject images whose decoded width or height exceeds 10,000 pixels.
ATTACHMENT_MAX_DIMENSION=10000
# Reject decompression bombs above 40 million decoded pixels.
ATTACHMENT_MAX_PIXELS=40000000
# Health and uploads fail closed below 1 GiB free storage.
ATTACHMENT_MIN_FREE_BYTES=1073741824
# Archived metadata and unreferenced blobs remain recoverable for these windows.
ATTACHMENT_RETENTION_DAYS=30
ATTACHMENT_ORPHAN_GRACE_HOURS=24
# Bound cross-process content-lock waits and worker cleanup cadence.
ATTACHMENT_CONTENT_LOCK_TIMEOUT_MS=5000
ATTACHMENT_CLEANUP_POLL_MS=3600000

# Local sync plugin enrollment
PUBLIC_API_URL=https://your-domain.example/api
LOCAL_SYNC_PACKAGE_VERSION=0.6.1

# Server-side editing assistant
# OpenCode is installed with the server package. Override only when using a
# separately managed binary.
# OPENCODE_BIN=/absolute/path/to/opencode
ASSIST_OPENCODE_FREE_MODELS=opencode/big-pickle
# Default true: after free models fail, one automatically discovered paid model may incur cost.
ASSIST_OPENCODE_ALLOW_PAID_FALLBACK=true
ASSIST_MAX_OUTSTANDING_PER_USER=10
ASSIST_OPENCODE_PAID_MODEL_EXCLUDES=
ASSIST_OPENCODE_MAX_FREE_ATTEMPTS=3
ASSIST_OPENCODE_MAX_PAID_ATTEMPTS=1
ASSIST_OPENCODE_TIMEOUT_MS=180000
ASSIST_OPENCODE_MODEL_CACHE_MS=600000
ASSIST_OPENCODE_MODEL_STALE_MS=3600000
ASSIST_OPENCODE_MODEL_ENUM_TIMEOUT_MS=10000
ASSIST_OPENCODE_ATTEMPT_TIMEOUT_MS=60000
ASSIST_OPENCODE_ESTIMATED_OUTPUT_TOKENS=2000
ASSIST_OPENCODE_CIRCUIT_FAILURES=3
ASSIST_OPENCODE_CIRCUIT_WINDOW_MS=300000
ASSIST_OPENCODE_CIRCUIT_OPEN_MS=120000
