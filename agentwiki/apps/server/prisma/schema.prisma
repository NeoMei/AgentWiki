generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentAccessRole {
  reader
  editor
  publisher
}

enum PageTemplateScope {
  system
  space
}

enum PageTemplateCategory {
  planning
  reporting
  knowledge
  other
}

enum CollaborationRunStatus {
  draft
  ready
  running
  waiting_review
  paused
  completed
  failed
  cancelled
}

enum CollaborationTaskStatus {
  blocked
  ready
  claimed
  running
  submitted
  completed
  retry_wait
  failed
  skipped
}

enum CollaborationTodoStatus {
  pending
  doing
  done
  failed
}

enum CollaborationDependencyMode {
  all
  any
}

enum CollaborationAttemptStatus {
  claimed
  running
  expired
  completed
  failed
  invalidated
}

enum CollaborationArtifactKind {
  markdown
  json
  external_reference
  evidence_summary
}

enum CollaborationArtifactStatus {
  pending
  accepted
  rejected
  superseded
}

enum CollaborationReviewStatus {
  pending
  approved
  rejected
  terminated
  superseded
}

// 用户表 - 支持人类用户和Agent
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  type         String  @default("human")
  platformRole String  @default("user")
  password     String?

  spaces                        SpaceMember[]
  pages                         Page[]                        @relation("PageAuthor")
  modifiedPages                 Page[]                        @relation("PageLastModifiedByUser")
  modifiedRelations             KnowledgeRelation[]           @relation("RelationLastModifiedByUser")
  pageVersions                  PageVersion[]
  apiKeys                       ApiKeyCredential[]
  auditEvents                   SecurityAuditEvent[]
  ownedAgents                   Agent[]
  createdSources                Source[]
  requestedRuns                 IngestRun[]
  createdChangeSets             ChangeSet[]
  createdRevisions              SpaceKnowledgeRevision[]      @relation("RevisionCreatedByUser")
  approvals                     Approval[]
  onboardingSessions            OnboardingDeviceSession[]
  obsidianInstallations         ObsidianInstallation[]
  humanDeviceCredentialFamilies HumanDeviceCredentialFamily[]
  humanDeviceCredentials        HumanDeviceCredential[]
  collaborationTemplatesCreated CollaborationTemplate[]       @relation("CollaborationTemplateCreatedBy")
  collaborationRunsStarted      CollaborationRun[]            @relation("CollaborationRunStartedBy")
  collaborationReviewsDecided   CollaborationReview[]         @relation("CollaborationReviewReviewer")
  collaborationEvents           CollaborationRunEvent[]       @relation("CollaborationEventUser")
  pageTemplatesCreated          PageTemplate[]                @relation("PageTemplateCreatedBy")
  pageTemplatesUpdated          PageTemplate[]                @relation("PageTemplateUpdatedBy")
  pageTemplateVersionsCreated   PageTemplateVersion[]         @relation("PageTemplateVersionCreatedBy")
  lockedAt                      DateTime?
  mustChangePassword            Boolean                       @default(false)
  authVersion                   Int                           @default(0)

  assistTasks AssistTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([platformRole])
}

model ApiKeyCredential {
  id         String    @id @default(cuid())
  name       String    @default("Personal access token")
  prefix     String
  keyHash    String    @unique
  scopes     String[]  @default(["*"])
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prefix])
  @@index([userId, revokedAt])
}

model SecurityAuditEvent {
  id        String  @id @default(cuid())
  action    String
  outcome   String
  ipAddress String?
  userAgent String?
  metadata  Json?

  actorUser    User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorAgent   Agent?  @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)
  actorAgentId String?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Space {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  visibility     String  @default("private")
  approvalPolicy String  @default("always-review")

  members SpaceMember[]
  pages   Page[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  agentGrants            AgentGrant[]
  sources                Source[]
  ingestRuns             IngestRun[]
  changeSets             ChangeSet[]
  knowledgeSubmissions   KnowledgeSubmission[]
  knowledgeRevisions     SpaceKnowledgeRevision[]
  agentMemories          AgentMemory[]
  assistTasks            AssistTask[]
  graphState             SpaceGraphState?
  collaborationTemplates CollaborationTemplate[]
  collaborationRuns      CollaborationRun[]
  pageTemplates          PageTemplate[]
}

model AssistTask {
  id           String  @id @default(cuid())
  status       String  @default("queued")
  intent       String
  pageSnapshot Json?
  result       Json?
  error        String?
  attempts     Int     @default(0)
  maxAttempts  Int     @default(3)

  space             Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId           String
  page              Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)
  pageId            String?
  requestedByUser   User?   @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByUserId String?

  lockedAt       DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([spaceId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([status, nextAttemptAt, createdAt], map: "AssistTask_status_nextAttempt_created_idx")
  @@index([pageId, createdAt(sort: Desc)])
}

model Agent {
  id            String  @id @default(cuid())
  name          String
  description   String?
  status        String  @default("active")
  approvalMode  String  @default("always-review")
  memoryEnabled Boolean @default(false)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  credentials       AgentCredential[]
  grants            AgentGrant[]
  auditEvents       AgentAuditEvent[]
  securityEvents    SecurityAuditEvent[]
  createdSources    Source[]
  requestedRuns     IngestRun[]
  createdChangeSets ChangeSet[]
  memories          AgentMemory[]
  createdPages      Page[]               @relation("PageCreatedByAgent")
  modifiedPages     Page[]               @relation("PageLastModifiedByAgent")
  createdRelations  KnowledgeRelation[]  @relation("RelationCreatedByAgent")
  collaborationRoleBindings  CollaborationRoleBinding[]
  collaborationAssignedTasks CollaborationRunTask[]
  collaborationAttempts      CollaborationTaskAttempt[]
  collaborationEvents        CollaborationRunEvent[]    @relation("CollaborationEventAgent")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@index([ownerId, status])
}

model AgentCredential {
  id                      String    @id @default(cuid())
  name                    String
  prefix                  String
  keyHash                 String    @unique
  localSyncInstallationId String?   @unique
  expiresAt               DateTime?
  revokedAt               DateTime?
  lastUsedAt              DateTime?

  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId         String
  authorization   AgentGrant @relation(fields: [authorizationId, agentId], references: [id, agentId], onDelete: Cascade)
  authorizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prefix])
  @@index([agentId, revokedAt])
  @@index([authorizationId, agentId])
}

model AgentGrant {
  id   String          @id @default(cuid())
  role AgentAccessRole @default(reader)

  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String
  credentials AgentCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, spaceId])
  @@unique([id, agentId])
  @@index([spaceId])
}

model AgentAuditEvent {
  id           String  @id @default(cuid())
  action       String
  outcome      String
  resourceType String?
  resourceId   String?
  metadata     Json?

  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([resourceType, resourceId])
}

model SpaceMember {
  id   String @id @default(cuid())
  role String @default("viewer")

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  createdAt DateTime @default(now())

  @@unique([userId, spaceId])
  @@index([spaceId, role, createdAt])
}

model Page {
  id              String                        @id @default(cuid())
  title           String
  slug            String
  knowledgeKey    String                        @unique @default(cuid())
  content         String                        @default("")
  format          String                        @default("markdown")
  embeddingVector Unsupported("halfvec(2048)")?

  parent    Page?   @relation("PageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  Page[]  @relation("PageChildren")
  sortOrder Int     @default(0)

  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId  String
  author   User   @relation("PageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  tags Tag[]

  versions PageVersion[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  sourceChangeSetId     String?
  createdByAgentId      String?
  lastChangeSetId       String?
  lastModifiedByUserId  String?
  lastModifiedByAgentId String?
  lastModifiedAt        DateTime  @default(now())
  sourceId              String?
  sourceVersionId       String?
  sourcePath            String?
  syncPath              String
  syncPathKey           String
  sourceTemplateId      String?
  sourceTemplateVersion Int?
  sourceTemplateLocale  String?

  sourceChangeSet             ChangeSet?            @relation("PageOriginChangeSet", fields: [sourceChangeSetId], references: [id], onDelete: SetNull)
  lastChangeSet               ChangeSet?            @relation("PageLastChangeSet", fields: [lastChangeSetId], references: [id], onDelete: SetNull)
  createdByAgent              Agent?                @relation("PageCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  lastModifiedByUser          User?                 @relation("PageLastModifiedByUser", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  lastModifiedByAgent         Agent?                @relation("PageLastModifiedByAgent", fields: [lastModifiedByAgentId], references: [id], onDelete: SetNull)
  source                      Source?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceVersion               SourceVersion?        @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)
  outgoingRelations           KnowledgeRelation[]   @relation("RelationSourcePage")
  incomingRelations           KnowledgeRelation[]   @relation("RelationTargetPage")
  searchDocument              PageSearchDocument?
  assistTasks                 AssistTask[]
  sourceTemplateVersionRecord PageTemplateVersion?  @relation("PageSourceTemplateVersion", fields: [sourceTemplateId, sourceTemplateVersion], references: [templateId, version], onDelete: Restrict, onUpdate: Restrict)
  templateVersionsSourced     PageTemplateVersion[] @relation("PageTemplateVersionSourcePage")

  @@unique([spaceId, slug])
  @@unique([spaceId, sourceId, sourcePath])
  @@unique([spaceId, syncPathKey])
  @@index([sourceId, sourceVersionId])
  @@index([sourceTemplateId, sourceTemplateVersion])
  @@index([spaceId, deletedAt, sortOrder])
}

model PageTemplate {
  id               String               @id @default(cuid())
  scope            PageTemplateScope
  scopeKey         String
  spaceId          String?
  stableKey        String
  category         PageTemplateCategory
  displayOrder     Int?
  nameI18n         Json
  nameKey          String?
  descriptionI18n  Json
  defaultTitleI18n Json
  sourceLocale     String?
  currentVersion   Int                  @default(1)
  createdById      String?
  updatedById      String?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  space     Space?                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("PageTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?                 @relation("PageTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  PageTemplateVersion[]

  @@unique([scopeKey, stableKey])
  @@unique([spaceId, nameKey])
  @@index([spaceId, archivedAt, updatedAt])
}

model PageTemplateVersion {
  id           String   @id @default(cuid())
  templateId   String
  version      Int
  contentI18n  Json
  sourcePageId String?
  contentHash  String
  createdById  String?
  createdAt    DateTime @default(now())

  template   PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sourcePage Page?        @relation("PageTemplateVersionSourcePage", fields: [sourcePageId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("PageTemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pages      Page[]       @relation("PageSourceTemplateVersion")

  @@unique([templateId, version])
  @@index([templateId, createdAt])
  @@index([sourcePageId])
}

model PageSearchDocument {
  pageId      String   @id
  text        String
  contentHash String
  indexedAt   DateTime @default(now())
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([contentHash])
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String?

  pages Page[]

  @@unique([name])
}

model PageVersion {
  id               String  @id @default(cuid())
  pageId           String
  title            String
  content          String
  authorId         String?
  slug             String?
  format           String?
  parentId         String?
  syncPath         String?
  syncPathKey      String?
  migrationBatchId String?

  page   Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([pageId, migrationBatchId])
  @@index([pageId])
  @@index([authorId])
}

model KnowledgeRelation {
  id                   String   @id @default(cuid())
  relation             String
  knowledgeKey         String   @default(cuid())
  sourcePageId         String
  targetPageId         String
  strength             Float    @default(1.0)
  confidence           Float    @default(1.0)
  origin               String   @default("manual")
  sourceChangeSetId    String?
  createdByAgentId     String?
  evidenceId           String?
  lastModifiedByUserId String?
  lastModifiedAt       DateTime @default(now())

  sourcePage         Page       @relation("RelationSourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage         Page       @relation("RelationTargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)
  sourceChangeSet    ChangeSet? @relation(fields: [sourceChangeSetId], references: [id], onDelete: SetNull)
  createdByAgent     Agent?     @relation("RelationCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  evidence           Evidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  lastModifiedByUser User?      @relation("RelationLastModifiedByUser", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([sourcePageId, targetPageId, relation])
  @@unique([knowledgeKey])
}

model SpaceGraphState {
  id                 String    @id @default(cuid())
  space              Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId            String    @unique
  wikilinkEnabled    Boolean   @default(true)
  similarEnabled     Boolean   @default(false)
  similarThreshold   Float     @default(0.86)
  llmEnabled         Boolean   @default(false)
  lastContentHash    String?
  lastRunAt          DateTime?
  lastLlmRunAt       DateTime?
  lastLlmChangeSetId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Source {
  id               String          @id @default(cuid())
  type             String
  name             String
  uri              String?
  status           String          @default("active")
  contentHash      String
  sourceKey        String?
  config           Json?
  space            Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId          String
  createdByUser    User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdByAgent   Agent?          @relation(fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdByAgentId String?
  versions         SourceVersion[]
  runs             IngestRun[]
  pages            Page[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime?

  @@unique([spaceId, type, contentHash])
  @@unique([spaceId, type, sourceKey])
  @@index([spaceId, status])
}

model SourceVersion {
  id          String               @id @default(cuid())
  version     Int
  content     String?
  contentHash String
  metadata    Json?
  source      Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId    String
  evidences   Evidence[]
  files       SourceFileSnapshot[]
  inputRuns   IngestRun[]          @relation("IngestRunInputVersion")
  pages       Page[]
  createdAt   DateTime             @default(now())

  @@unique([sourceId, version])
  @@unique([sourceId, contentHash])
  @@index([contentHash])
}

model SourceFileSnapshot {
  id              String        @id @default(cuid())
  path            String
  contentHash     String
  size            Int
  commit          String?
  sourceVersion   SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  sourceVersionId String
  createdAt       DateTime      @default(now())

  @@unique([sourceVersionId, path])
  @@index([contentHash])
}

model IngestRun {
  id                      String         @id @default(cuid())
  idempotencyKey          String?
  status                  String         @default("queued")
  stage                   String         @default("queued")
  attempts                Int            @default(0)
  maxAttempts             Int            @default(3)
  error                   String?
  result                  Json?
  cancelRequested         Boolean        @default(false)
  lockedAt                DateTime?
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  nextAttemptAt           DateTime?
  source                  Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId                String
  inputSourceVersion      SourceVersion? @relation("IngestRunInputVersion", fields: [inputSourceVersionId], references: [id], onDelete: SetNull)
  inputSourceVersionId    String?
  space                   Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId                 String
  requestedByUser         User?          @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByUserId       String?
  requestedByAgent        Agent?         @relation(fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  requestedByAgentId      String?
  requestedScopes         String[]       @default([])
  requestedCredentialId   String?
  requestedCredentialType String?
  artifacts               Artifact[]
  evidences               Evidence[]
  changeSet               ChangeSet?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  completedAt             DateTime?

  @@unique([sourceId, idempotencyKey])
  @@index([spaceId, status, createdAt])
  @@index([sourceId, createdAt])
  @@index([inputSourceVersionId])
  @@index([status, leaseExpiresAt])
}

model Artifact {
  id        String    @id @default(cuid())
  type      String
  content   String
  metadata  Json?
  run       IngestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  createdAt DateTime  @default(now())

  @@index([runId, type])
}

model Evidence {
  id               String              @id @default(cuid())
  quote            String?
  location         Json?
  confidence       Float               @default(1.0)
  targetPageId     String?
  targetRelationId String?
  sourceVersion    SourceVersion       @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  sourceVersionId  String
  run              IngestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId            String
  createdAt        DateTime            @default(now())
  agentMemories    AgentMemory[]
  relations        KnowledgeRelation[]

  @@index([runId])
  @@index([targetPageId])
  @@index([targetRelationId])
}

model ChangeSet {
  id                      String                  @id @default(cuid())
  title                   String
  status                  String                  @default("draft")
  space                   Space                   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId                 String
  run                     IngestRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  runId                   String?                 @unique
  createdByUser           User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId         String?
  createdByAgent          Agent?                  @relation(fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdByAgentId        String?
  items                   ChangeItem[]
  approvals               Approval[]
  knowledgeSubmission     KnowledgeSubmission?    @relation("ChangeSetKnowledgeSubmission")
  knowledgeRevisions      SpaceKnowledgeRevision[] @relation("ChangeSetKnowledgeRevision")
  originPages             Page[]                  @relation("PageOriginChangeSet")
  changedPages            Page[]                  @relation("PageLastChangeSet")
  relations               KnowledgeRelation[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  reviewedAt              DateTime?
  publishedAt             DateTime?
  revertedAt              DateTime?
  origin                  String                  @default("review")
  humanDeviceCredentialId String?
  confirmationHash        String?
  baseRevisionId          String?

  humanDeviceCredential HumanDeviceCredential? @relation(fields: [humanDeviceCredentialId], references: [id], onDelete: SetNull)

  @@index([spaceId, status, createdAt])
}

model ChangeItem {
  id                  String    @id @default(cuid())
  type                String
  payload             Json
  status              String    @default("pending")
  publishedResourceId String?
  changeSet           ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  changeSetId         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([changeSetId, status])
}

model Approval {
  id          String    @id @default(cuid())
  decision    String
  comment     String?
  changeSet   ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  changeSetId String
  reviewer    User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId  String
  createdAt   DateTime  @default(now())

  @@index([changeSetId, createdAt])
}

model AgentMemory {
  id               String    @id @default(cuid())
  type             String
  content          String
  importance       Float     @default(0.5)
  tags             String[]  @default([])
  entities         Json?
  contentHash      String
  visibility       String    @default("private")
  embedding        Float[]   @default([])
  embeddingModel   String?
  status           String    @default("active")
  sourceEvidence   Evidence? @relation(fields: [sourceEvidenceId], references: [id], onDelete: SetNull)
  sourceEvidenceId String?
  sourceMemoryIds  String[]  @default([])
  expiresAt        DateTime?
  lastAccessedAt   DateTime?
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId          String
  space            Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?
  deletedAt        DateTime?

  @@unique([agentId, spaceId, type, contentHash])
  @@index([agentId, spaceId, status])
  @@index([expiresAt])
}

model KnowledgeSubmission {
  id                String   @id @default(cuid())
  spaceId           String
  baseRevisionId    String?
  principalKey      String
  idempotencyKey    String
  schemaVersion     String
  recipeVersion     String
  contentHash       String
  bundle            Json
  status            String   @default("pending")
  changeSetId       String?  @unique
  appliedRevisionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  space           Space                   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  changeSet       ChangeSet?              @relation("ChangeSetKnowledgeSubmission", fields: [changeSetId], references: [id], onDelete: SetNull)
  appliedRevision SpaceKnowledgeRevision? @relation("AppliedKnowledgeRevision", fields: [appliedRevisionId], references: [id], onDelete: SetNull)

  @@unique([spaceId, principalKey, idempotencyKey])
  @@index([spaceId, status, createdAt])
}

model SpaceKnowledgeRevision {
  id                         String    @id @default(cuid())
  spaceId                    String
  sequence                   Int
  parentRevisionId           String?
  schemaVersion              String
  recipeVersion              String
  contentHash                String
  snapshot                   Json?
  delta                      Json?
  revisionContentHash        String
  pageCount                  BigInt
  revisionBodyBytes          BigInt
  revisionManifestByteLength BigInt
  supersededAt               DateTime?
  origin                     String?
  createdByUserId            String?
  humanDeviceCredentialId    String?
  migrationBatchId           String?
  sourceChangeSetId          String?
  createdAt                  DateTime  @default(now())

  space                 Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  appliedSubmission     KnowledgeSubmission?   @relation("AppliedKnowledgeRevision")
  sourceChangeSet       ChangeSet?             @relation("ChangeSetKnowledgeRevision", fields: [sourceChangeSetId], references: [id], onDelete: SetNull)
  createdByUser         User?                  @relation("RevisionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  humanDeviceCredential HumanDeviceCredential? @relation(fields: [humanDeviceCredentialId], references: [id], onDelete: SetNull)

  @@unique([spaceId, sequence])
  @@index([spaceId, contentHash])
  @@unique([spaceId, migrationBatchId])
  @@index([sourceChangeSetId])
  @@index([spaceId, createdAt])
}

model OnboardingDeviceSession {
  id                    String               @id @default(cuid())
  deviceCodeHash        String               @unique
  userCodeHash          String               @unique
  packageVersion        String
  clientType            String
  purpose               String
  requestedCapabilities String[]
  status                String               @default("pending")
  pollIntervalSeconds   Int                  @default(5)
  pollCount             Int                  @default(0)
  lastPolledAt          DateTime?
  authorizedUserId      String?
  authorizedUser        User?                @relation(fields: [authorizedUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  deniedAt              DateTime?
  expiresAt             DateTime
  onboardingTokenHash   String?              @unique
  tokenExpiresAt        DateTime?
  tokenConsumedAt       DateTime?
  bootstrap             OnboardingBootstrap?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, expiresAt])
  @@index([authorizedUserId, createdAt])
}

model OnboardingBootstrap {
  id                 String                  @id @default(cuid())
  deviceSessionId    String                  @unique
  deviceSession      OnboardingDeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  idempotencyKeyHash String
  serverPlanHash     String
  status             String                  @default("running")
  executionId        String?
  generation         Int                     @default(0)
  leaseExpiresAt     DateTime?
  resourceIds        Json?
  resultHash         String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([deviceSessionId, idempotencyKeyHash])
}

model SyncPageContentRow {
  contentHash String @id
  body        String
  byteLength  Int

  revisionRows SyncRevisionPageRow[]
}

model SyncRevisionPageRow {
  revisionId  String
  pageId      String
  path        String
  pathKey     String
  title       String
  contentHash String
  updatedAt   DateTime

  content SyncPageContentRow @relation(fields: [contentHash], references: [contentHash], onDelete: Restrict)

  @@id([revisionId, pageId])
  @@unique([revisionId, pathKey])
}

model SyncRevisionDeltaRow {
  revisionId   String
  ordinal      Int
  operation    String
  pageId       String
  previousPath String?
  contentHash  String?

  @@id([revisionId, ordinal])
  @@unique([revisionId, pageId])
}

model LegacyRevisionSidecar {
  revisionId String @id
  sidecar    Json
}

model LegacyRevisionPageExtra {
  revisionId     String
  pageId         String
  ordinal        Int
  extra          Json
  legacyBodyHash String

  @@id([revisionId, pageId])
  @@unique([revisionId, ordinal])
}

model LegacyPageBodyRow {
  contentHash String @id
  body        Json
}

model PushSession {
  id                     String   @id @default(uuid())
  credentialFamilyId     String
  credentialId           String
  userId                 String
  spaceId                String
  baseRevisionId         String
  idempotencyKey         String
  status                 String   @default("uploading")
  capabilitiesHash       String
  confirmationHash       String
  confirmationByteLength Int
  changeCount            Int
  totalBodyBytes         BigInt
  receivedBatchCount     Int      @default(0)
  receivedChangeCount    Int      @default(0)
  receivedBodyBytes      BigInt   @default(0)
  expiresAt              DateTime
  publishedChangeSetId   String?
  result                 Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  batches           PushSessionBatch[]
  PushSessionChange PushSessionChange[]

  @@unique([credentialFamilyId, idempotencyKey])
  @@unique([spaceId, publishedChangeSetId])
  @@index([spaceId, status, expiresAt])
  @@index([credentialId, spaceId])
}

model PushSessionBatch {
  id         String              @id @default(uuid())
  sessionId  String
  batchIndex Int
  batchHash  String
  receipt    String
  changes    PushSessionChange[]
  createdAt  DateTime            @default(now())

  session PushSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, batchIndex])
  @@unique([sessionId, batchHash])
}

model PushSessionChange {
  id           String  @id @default(uuid())
  sessionId    String
  batchId      String
  ordinal      Int
  operation    String
  pageId       String
  path         String?
  title        String?
  body         String?
  contentHash  String?
  previousPath String?

  batch   PushSessionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  session PushSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageId])
  @@index([sessionId, ordinal])
}

model ServerInstanceIdentity {
  id                 String   @id @default(cuid())
  instanceId         String   @unique
  deploymentSeedHash String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ObsidianInstallation {
  id          String    @id @default(uuid())
  codeHash    String    @unique
  status      String    @default("pending")
  exchangeId  String?
  requestHash String?
  expiresAt   DateTime
  exchangedAt DateTime?
  revokedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model HumanDeviceCredentialFamily {
  id       String @id @default(uuid())
  deviceId String
  vaultId  String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  credentials HumanDeviceCredential[]

  createdAt DateTime @default(now())

  @@unique([userId, deviceId, vaultId])
}

model HumanDeviceCredential {
  id                   String    @id @default(uuid())
  credentialFamilyId   String
  deviceId             String
  vaultId              String
  deviceName           String
  credentialHash       String    @unique
  status               String    @default("provisional")
  provisionalExpiresAt DateTime?
  activatedAt          DateTime?
  lastUsedAt           DateTime?
  revokedAt            DateTime?

  family HumanDeviceCredentialFamily @relation(fields: [credentialFamilyId], references: [id], onDelete: Cascade)
  user   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  changeSets ChangeSet[]
  revisions  SpaceKnowledgeRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialFamilyId, status])
  @@index([userId, createdAt])
  @@index([credentialFamilyId, provisionalExpiresAt])
}

model CollaborationTemplate {
  id          String    @id @default(cuid())
  spaceId     String?
  scopeKey    String
  slug        String
  name        String
  description String    @default("")
  version     Int       @default(1)
  seedVersion Int?
  system      Boolean   @default(false)
  archivedAt  DateTime?
  definition  Json
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  space     Space?             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("CollaborationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs      CollaborationRun[]

  @@unique([scopeKey, slug])
  @@index([spaceId, archivedAt])
}

model CollaborationRun {
  id               String                 @id @default(cuid())
  spaceId          String
  templateId       String
  templateVersion  Int
  templateSnapshot Json
  snapshotHash     String
  name             String
  status           CollaborationRunStatus @default(draft)
  version          Int                    @default(1)
  inputs           Json
  startedById      String
  pauseReason      String?
  eventSequence    Int                    @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  template     CollaborationTemplate         @relation(fields: [templateId], references: [id])
  space        Space                         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  startedBy    User                          @relation("CollaborationRunStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  roleBindings CollaborationRoleBinding[]
  tasks        CollaborationRunTask[]
  dependencies CollaborationTaskDependency[]
  reviews      CollaborationReview[]
  events       CollaborationRunEvent[]

  @@index([spaceId, status, updatedAt])
}

model CollaborationRoleBinding {
  id           String @id @default(cuid())
  runId        String
  roleSlotId   String
  roleSlotName String
  agentId      String

  run   CollaborationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([runId, roleSlotId])
  @@index([agentId, runId])
}

model CollaborationRunTask {
  id                  String                      @id @default(cuid())
  runId               String
  nodeId              String
  ordinal             Int
  name                String
  objective           String
  roleSlotId          String
  assigneeAgentId     String
  status              CollaborationTaskStatus     @default(blocked)
  generation          Int                         @default(1)
  dependencyMode      CollaborationDependencyMode @default(all)
  outputContract      Json
  requiredEvidence    Json
  humanAcceptance     Boolean                     @default(false)
  skippable           Boolean                     @default(false)
  leaseSeconds        Int
  maxExecutionSeconds Int
  retryBudget         Int                         @default(0)
  repairBudget        Int                         @default(0)
  nextAttemptAt       DateTime?
  completedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  run             CollaborationRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  assignee        Agent                       @relation(fields: [assigneeAgentId], references: [id], onDelete: Restrict)
  todos           CollaborationTaskTodo[]
  attempts        CollaborationTaskAttempt[]
  artifacts       CollaborationTaskArtifact[]
  sourceReviews   CollaborationReview[]       @relation("CollaborationReviewSourceTask")
  revisionReviews CollaborationReview[]       @relation("CollaborationReviewRevisionTask")

  @@unique([id, runId])
  @@unique([runId, nodeId])
  @@index([runId, assigneeAgentId, status, ordinal])
  @@index([status, nextAttemptAt])
}

model CollaborationTaskTodo {
  id         String                  @id @default(cuid())
  runId      String
  taskId     String
  generation Int
  templateId String
  ordinal    Int
  name       String
  required   Boolean                 @default(true)
  status     CollaborationTodoStatus @default(pending)
  summary    String?
  evidence   Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  task CollaborationRunTask @relation(fields: [taskId, runId], references: [id, runId], onDelete: Cascade)

  @@unique([taskId, generation, templateId])
  @@unique([taskId, generation, ordinal])
  @@index([runId, createdAt, id])
}

model CollaborationTaskDependency {
  id         String                      @id @default(cuid())
  runId      String
  fromNodeId String
  toNodeId   String
  mode       CollaborationDependencyMode

  run CollaborationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, fromNodeId, toNodeId])
  @@index([runId, toNodeId])
}

model CollaborationTaskAttempt {
  id                  String                     @id @default(cuid())
  runId               String
  taskId              String
  generation          Int
  agentId             String
  attemptNumber       Int
  status              CollaborationAttemptStatus
  claimIdempotencyKey String
  leaseTokenHash      String
  leaseStartedAt      DateTime
  leaseExpiresAt      DateTime
  maxExecutionAt      DateTime
  failureCode         String?
  repairCount         Int                        @default(0)
  finishedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  runTask   CollaborationRunTask        @relation(fields: [taskId, runId], references: [id, runId], onDelete: Cascade)
  agent     Agent                       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  artifacts CollaborationTaskArtifact[]

  @@unique([taskId, generation, attemptNumber])
  @@unique([id, taskId, runId, generation])
  @@index([runId, agentId, status])
  @@index([status, leaseExpiresAt], map: "CollaborationTaskAttempt_lease_scan")
}

model CollaborationTaskArtifact {
  id         String                      @id @default(cuid())
  runId      String
  taskId     String
  attemptId  String
  generation Int
  version    Int
  kind       CollaborationArtifactKind
  status     CollaborationArtifactStatus @default(pending)
  payload    Json
  evidence   Json
  acceptedAt DateTime?
  createdAt  DateTime                    @default(now())

  task    CollaborationRunTask     @relation(fields: [taskId, runId], references: [id, runId], onDelete: Cascade)
  attempt CollaborationTaskAttempt @relation(fields: [attemptId, taskId, runId, generation], references: [id, taskId, runId, generation], onDelete: Restrict)
  reviews CollaborationReview[]

  @@unique([id, taskId, runId, generation])
  @@unique([taskId, generation, version])
  @@index([taskId, generation, status, version])
}

model CollaborationReview {
  id              String                    @id @default(cuid())
  runId           String
  nodeId          String
  revision        Int                       @default(1)
  generation      Int
  sourceTaskId    String
  artifactId      String
  revisionTaskId  String
  minimumRole     String
  reviewerUserIds Json
  allowTerminate  Boolean                   @default(false)
  status          CollaborationReviewStatus @default(pending)
  reviewerUserId  String?
  reason          String?
  decidedAt       DateTime?
  createdAt       DateTime                  @default(now())

  run          CollaborationRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTask   CollaborationRunTask      @relation("CollaborationReviewSourceTask", fields: [sourceTaskId, runId], references: [id, runId], onDelete: Cascade)
  revisionTask CollaborationRunTask      @relation("CollaborationReviewRevisionTask", fields: [revisionTaskId, runId], references: [id, runId], onDelete: Restrict)
  artifact     CollaborationTaskArtifact @relation(fields: [artifactId, sourceTaskId, runId, generation], references: [id, taskId, runId, generation], onDelete: Restrict, map: "CollaborationReview_artifact_source_identity_fkey")
  reviewer     User?                     @relation("CollaborationReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@unique([runId, nodeId, revision])
  @@index([runId, status])
}

model CollaborationRunEvent {
  id             String   @id @default(cuid())
  runId          String
  sequence       Int
  type           String
  actorKind      String
  actorId        String
  operation      String
  target         String
  actorUserId    String?
  actorAgentId   String?
  idempotencyKey String
  requestHash    String
  metadata       Json
  response       Json?
  createdAt      DateTime @default(now())

  run        CollaborationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  actorUser  User?            @relation("CollaborationEventUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAgent Agent?           @relation("CollaborationEventAgent", fields: [actorAgentId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@unique([runId, actorKind, actorId, operation, idempotencyKey])
  @@index([runId, createdAt])
}
