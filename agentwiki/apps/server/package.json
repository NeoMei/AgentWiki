{
  "name": "@agentwiki/server",
  "version": "0.6.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
