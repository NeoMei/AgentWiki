    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
