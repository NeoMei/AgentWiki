# Database
DATABASE_URL=postgresql://agentwiki:your_postgres_password@localhost:5432/agentwiki

# Redis
REDIS_URL=redis://localhost:6379

# Application Secrets
APP_SECRET=your_app_secret_here
API_KEY_SECRET=your_api_key_secret_here
JWT_SECRET=your_jwt_secret_here_change_in_production_64bytes_minimum_recommended

# Local sync plugin enrollment
PUBLIC_API_URL=http://localhost:3000/api
# For HTTPS via Nginx, set: PUBLIC_API_URL=https://your-domain.com/api
LOCAL_SYNC_PACKAGE_VERSION=0.3.0

# CORS — add your HTTPS origin when using Nginx
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost,https://your-domain.com

# LLM Configuration
# Default gateway: openrouter (recommended) or direct
LLM_GATEWAY=openrouter
LLM_DEFAULT_MODEL=deepseek-chat

# The editing assistant uses the OpenCode CLI bundled with @agentwiki/server.
# OPENCODE_BIN is optional and should only point to a trusted absolute binary.
# OPENCODE_BIN=/absolute/path/to/opencode
ASSIST_OPENCODE_FREE_MODELS=opencode/big-pickle
# Default true: after free models fail, one automatically discovered paid model may incur cost.
ASSIST_OPENCODE_ALLOW_PAID_FALLBACK=true
ASSIST_MAX_OUTSTANDING_PER_USER=10
ASSIST_OPENCODE_PAID_MODEL_EXCLUDES=
ASSIST_OPENCODE_MAX_FREE_ATTEMPTS=3
ASSIST_OPENCODE_MAX_PAID_ATTEMPTS=1
ASSIST_OPENCODE_TIMEOUT_MS=180000
ASSIST_OPENCODE_MODEL_CACHE_MS=600000
ASSIST_OPENCODE_MODEL_STALE_MS=3600000
ASSIST_OPENCODE_MODEL_ENUM_TIMEOUT_MS=10000
ASSIST_OPENCODE_ATTEMPT_TIMEOUT_MS=60000
ASSIST_OPENCODE_ESTIMATED_OUTPUT_TOKENS=2000
ASSIST_OPENCODE_CIRCUIT_FAILURES=3
ASSIST_OPENCODE_CIRCUIT_WINDOW_MS=300000
ASSIST_OPENCODE_CIRCUIT_OPEN_MS=120000

# OpenRouter API Key (unified gateway for all models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct API Keys (fallback when not using OpenRouter)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
GLM_API_KEY=your_glm_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
