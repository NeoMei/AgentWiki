{
  "name": "agentwiki",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "build": "pnpm --filter shared build && pnpm --filter @neomei/agentwiki-sync-protocol build && pnpm --filter server build && pnpm --filter client build && pnpm --filter @neomei/agentwiki-local-sync build",
    "test": "pnpm test:runtime && pnpm --filter @agentwiki/server test && pnpm --filter @agentwiki/client test && pnpm --filter @neomei/agentwiki-sync-protocol test && pnpm --filter @neomei/agentwiki-local-sync test",
    "typecheck": "pnpm --filter @agentwiki/server typecheck && pnpm --filter @agentwiki/client exec tsc --noEmit && pnpm --filter @neomei/agentwiki-sync-protocol typecheck && pnpm --filter @neomei/agentwiki-local-sync typecheck",
    "lint": "eslint \"apps/{server,client}/src/**/*.{ts,tsx}\" \"packages/local-sync/src/**/*.ts\"",
    "test:runtime": "node --test scripts/*.test.mjs",
    "test:e2e:assist": "node scripts/assist-routing-e2e.mjs",
    "test:e2e:smoke": "node scripts/smoke-test.mjs",
    "test:e2e:cross-machine": "pnpm --filter @neomei/agentwiki-local-sync build && node scripts/cross-machine-e2e.mjs",
    "test:e2e:space-agent-ui": "node scripts/test-space-agent-member.mjs",
    "test:e2e:ui-routes": "node scripts/ui-route-smoke.mjs",
    "postinstall": "pnpm --filter @agentwiki/server exec prisma generate",
    "server:dev": "pnpm --filter server start:dev",
    "client:dev": "pnpm --filter client dev",
    "test:e2e:onboarding": "node scripts/onboarding-e2e.test.mjs",
    "test:package:local-sync-clean-install": "node scripts/verify-local-sync-clean-install.mjs",
    "test:e2e:codegraph-standard-scan": "pnpm --filter @neomei/agentwiki-local-sync build && node --test scripts/codegraph-standard-scan-e2e.test.mjs",
    "backfill:sync-v1": "node scripts/backfill-sync-v1.mjs",
    "migrate:readable-sync-paths": "pnpm --filter @neomei/agentwiki-sync-protocol build && pnpm --filter @agentwiki/server build && node scripts/migrate-readable-sync-paths.mjs",
    "instance:rotate": "node scripts/instance-rotate.mjs",
    "test:e2e:sync-v1-db": "node --test scripts/sync-v1-db.test.mjs",
    "test:e2e:sync-v1-writer-db": "node --test scripts/sync-v1-writer-db.test.mjs",
    "test:e2e:sync-v1-compat-db": "node --test scripts/sync-v1-compat-db.test.mjs",
    "test:e2e:sync-v1-concurrency-db": "node --test scripts/sync-v1-concurrency-db.test.mjs",
    "test:e2e:sync-v1-advance-db": "node --test scripts/sync-v1-advance-db.test.mjs",
    "test:e2e:sync-v1-http": "node --test scripts/sync-v1-http-e2e.test.mjs",
    "test:e2e:collaboration-schema-db": "node --test scripts/collaboration-schema-db.test.mjs",
    "test:e2e:collaboration-db": "node --test scripts/collaboration-workflows-db.test.mjs",
    "test:e2e:collaboration": "node scripts/collaboration-workflows-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0"
  }
}
