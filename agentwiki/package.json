{
  "name": "agentwiki",
  "version": "0.2.9",
  "private": true,
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "build": "pnpm --filter shared build && pnpm --filter server build && pnpm --filter client build && pnpm --filter @neomei/agentwiki-local-sync build",
    "test": "pnpm test:runtime && pnpm --filter @agentwiki/server test && pnpm --filter @agentwiki/client test && pnpm --filter @neomei/agentwiki-local-sync test",
    "typecheck": "pnpm --filter @agentwiki/server typecheck && pnpm --filter @agentwiki/client exec tsc --noEmit && pnpm --filter @neomei/agentwiki-local-sync typecheck",
    "lint": "eslint \"apps/{server,client}/src/**/*.{ts,tsx}\" \"packages/local-sync/src/**/*.ts\"",
    "test:runtime": "node --test scripts/*.test.mjs",
    "test:e2e:assist": "node scripts/assist-routing-e2e.mjs",
    "test:e2e:local-sync": "node scripts/local-sync-e2e.mjs",
    "test:e2e:smoke": "node scripts/smoke-test.mjs",
    "test:e2e:cross-machine": "pnpm --filter @neomei/agentwiki-local-sync build && node scripts/cross-machine-e2e.mjs",
    "test:e2e:space-agent-ui": "node scripts/test-space-agent-member.mjs",
    "test:e2e:ui-routes": "node scripts/ui-route-smoke.mjs",
    "postinstall": "pnpm --filter @agentwiki/server exec prisma generate",
    "server:dev": "pnpm --filter server start:dev",
    "client:dev": "pnpm --filter client dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0"
  }
}
