{
  "name": "@neomei/agentwiki-sync-protocol",
  "version": "0.4.0",
  "description": "Browser-compatible canonicalization, hashing, and strict schemas for AgentWiki Sync v1-v3",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./test-vectors/sync-v3.json": "./test-vectors/sync-v3.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js",
    "test-vectors/sync-v3.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "prepack": "pnpm build && pnpm test"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
