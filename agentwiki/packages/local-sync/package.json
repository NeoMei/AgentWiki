{
  "name": "@neomei/agentwiki-local-sync",
  "version": "0.3.4",
  "description": "Local knowledge adapter and AgentWiki synchronization for coding agents",
  "type": "module",
  "bin": {
    "agentwiki-local-sync": "dist/cli.js"
  },
  "main": "./dist/gateway/server.js",
  "types": "./dist/gateway/server.d.ts",
  "files": [
    "dist",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js",
    "!dist/mcp.d.ts",
    "!dist/mcp.js",
    "!dist/orchestrator-commands.d.ts",
    "!dist/orchestrator-commands.js",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "prepack": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
