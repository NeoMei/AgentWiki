{
  "name": "@neomei/agentwiki-local-sync",
  "version": "0.4.0",
  "description": "Local knowledge adapter and AgentWiki synchronization for coding agents",
  "type": "module",
  "bin": {
    "agentwiki-local-sync": "dist/cli.js"
  },
  "main": "./dist/gateway/server.js",
  "types": "./dist/gateway/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gateway/server.d.ts",
      "import": "./dist/gateway/server.js",
      "default": "./dist/gateway/server.js"
    },
    "./package.json": "./package.json",
    "./skill/*": "./skill/*",
    "./dist/adapter/index.js": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js",
      "default": "./dist/adapter/index.js"
    },
    "./dist/adapter/manager.js": {
      "types": "./dist/adapter/manager.d.ts",
      "import": "./dist/adapter/manager.js",
      "default": "./dist/adapter/manager.js"
    },
    "./dist/adapter/markitdown.js": {
      "types": "./dist/adapter/markitdown.d.ts",
      "import": "./dist/adapter/markitdown.js",
      "default": "./dist/adapter/markitdown.js"
    },
    "./dist/core/*": "./dist/core/*",
    "./dist/gateway/*": "./dist/gateway/*",
    "./dist/installer/*": "./dist/installer/*",
    "./dist/onboarding/*": "./dist/onboarding/*",
    "./dist/organize/*": "./dist/organize/*",
    "./dist/protocol/*": "./dist/protocol/*",
    "./dist/sync/*": "./dist/sync/*",
    "./dist/utils/*": "./dist/utils/*",
    "./dist/workspace/*": "./dist/workspace/*",
    "./dist/agent-clients.js": {
      "types": "./dist/agent-clients.d.ts",
      "import": "./dist/agent-clients.js",
      "default": "./dist/agent-clients.js"
    },
    "./dist/agentwiki-client.js": {
      "types": "./dist/agentwiki-client.d.ts",
      "import": "./dist/agentwiki-client.js",
      "default": "./dist/agentwiki-client.js"
    },
    "./dist/cli.js": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./dist/config.js": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./dist/recipes.js": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js",
      "default": "./dist/recipes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js",
    "!dist/orchestrator-commands.d.ts",
    "!dist/orchestrator-commands.js",
    "scripts/clean-dist.mjs",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "prepack": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
